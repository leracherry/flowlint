{
  "name": "@leracherry/flowlint",
  "version": "1.0.0",
  "description": "Offline lifecycle linting for AG-UI agent event traces",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leracherry/flowlint.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.17.1",
  "bin": {
    "flowlint": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "REFERENCE.md",
    "COMPATIBILITY.md",
    "LICENSE",
    "CHANGELOG.md",
    "RELEASING.md",
    "examples"
  ],
  "scripts": {
    "build": "tsup",
    "demo": "pnpm build && node scripts/demo.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:html": "pnpm build && node scripts/verify-html.mjs",
    "stress": "pnpm build && node scripts/stress.mjs && node scripts/stress-stream.mjs && node scripts/stress-compare.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepack": "pnpm build",
    "verify:package": "pnpm build && node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.2",
    "commander": "14.0.3",
    "jsonc-parser": "3.3.1",
    "tinyglobby": "0.2.17",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@ag-ui/client": "1.0.3",
    "@types/node": "^22.0.0",
    "cross-spawn": "7.0.6",
    "eslint": "^9.39.0",
    "playwright": "1.64.1",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "ag-ui",
    "ai-agents",
    "linter",
    "typescript",
    "cli",
    "event-streams"
  ],
  "homepage": "https://github.com/leracherry/flowlint#readme",
  "bugs": {
    "url": "https://github.com/leracherry/flowlint/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
