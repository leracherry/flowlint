{
  "name": "@leracherry/flowlint",
  "version": "0.1.0",
  "description": "Offline lifecycle linting for AG-UI agent event traces",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leracherry/flowlint.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.17.1",
  "bin": {
    "flowlint": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.2",
    "zod": "3.25.76",
    "commander": "14.0.3",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "tsup": "^8.5.0",
    "vitest": "^3.2.4",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.71.1",
    "prettier": "^3.6.2"
  }
}
